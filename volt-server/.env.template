# Volt Security Backend — environment template
# Copy to .env and fill in your values

# ── Wazuh ──────────────────────────────────────────────────────────────────
WAZUH_URL=https://your-wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=
WAZUH_VERIFY_SSL=false   # set true if you have a trusted cert

# ── Suricata ───────────────────────────────────────────────────────────────
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# ── ntopng ─────────────────────────────────────────────────────────────────
NTOPNG_URL=http://localhost:3000
NTOPNG_USER=admin
NTOPNG_PASS=

# ── Splunk ─────────────────────────────────────────────────────────────────
SPLUNK_URL=https://your-splunk:8089
SPLUNK_TOKEN=           # Splunk API token (Settings → Tokens)

# ── Server ─────────────────────────────────────────────────────────────────
VOLT_PORT=8000
VOLT_CORS_ORIGINS=*     # tighten in prod: http://localhost:3000,https://yourdomain.com
